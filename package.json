{
  "name": "palletizer-sim",
  "version": "4.0.0",
  "private": true,
  "description": "Тренажёр РТК паллетизации: конфигуратор ячейки, расчёты, симуляция и 3D-вид в одном HTML-файле",
  "scripts": {
    "build": "node build.js",
    "test": "node build.js && node test/headless.js",
    "serve": "node -e \"const h=require('http'),f=require('fs');h.createServer((q,s)=>{s.setHeader('content-type','text/html; charset=utf-8');s.end(f.readFileSync('dist/palletizer-sim.html'))}).listen(8080,()=>console.log('http://localhost:8080'))\""
  },
  "devDependencies": {
    "jsdom": "^24.0.0"
  }
}
